# ======================== .NET WPF 核心忽略规则 ========================
# 1. Visual Studio 核心缓存/配置文件
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/
.idea/
*.sln.iml
.cr/

# 2. 编译输出目录
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
publish/
bld/

# 3. WPF 本地配置/调试文件
**/Properties/launchSettings.json
appsettings*.Local.json
appsettings*.Development.json
*.vshost.exe
*.vshost.exe.config
*.vshost.exe.manifest

# 4. NuGet 相关
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
project.lock.json
project.assets.json
paket-files/
.paket/

# 5. 测试/覆盖率文件
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.coverage
*.runsettings

# 6. 临时/备份文件
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
*.bak
*.tmp
*.cache
*.log

# 7. WPF 设计时/生成文件
Generated_Code/
*.g.cs
*.g.i.cs
DesignTimeBuild/
FileContentIndex/

# 8. 大型资源/无关文件
*.zip
*.rar
*.7z
*.mp4
*.avi
*.png.bak
*.xaml.bak

# 9. 第三方工具/插件文件
.vs/*/CopilotIndices/
*.GhostDoc.xml
_ReSharper*/
*.DotSettings.user
StyleCop.Cache
*_ncrunch_*
*.ncrunchproject
FakesAssemblies/

# 10. 系统/临时文件
.DS_Store
Thumbs.db
desktop.ini
