<UserControl
    x:Class="ParkingLot.Main.Common.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ParkingLot.Main.Common.Views"
    xmlns:dpproperty="clr-namespace:ParkingLot.Main.Core.Extensions"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:converts="clr-namespace:ParkingLot.Core.Converters;assembly=ParkingLot.Core"
    prism:Dialog.WindowStartupLocation="CenterScreen"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="White"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <!--  2. 禁止调整大小  -->
            <Setter Property="ResizeMode" Value="NoResize" />
            <!--  3. 固定对话框宽高  -->
            <Setter Property="Width" Value="750" />
            <Setter Property="Height" Value="500" />
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <Style
            x:Key="UserNameTextBox"
            TargetType="TextBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <!--  底部横线  -->
                            <Border x:Name="Line"
                                Margin="0,28,0,0"
                                BorderThickness="0,0,0,1"
                                BorderBrush="#CCCCCC" />

                            <!--  输入区域  -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                Margin="0,0,0,5" />

                            <!--  水印文字：未输入 & 未聚焦 时显示  -->
                            <TextBlock x:Name="Watermark"
                                Text="账号/电话/邮箱"
                                Margin="5,0,0,5"
                                VerticalAlignment="Center"
                                Foreground="#999999"
                                FontSize="14"
                                Visibility="Collapsed"
                                IsHitTestVisible="False" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!--  鼠标悬浮 → 底部横线高亮  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="BorderBrush" Value="#0078D7" />
                            </Trigger>

                            <DataTrigger
                                Binding="{Binding Path=Text, RelativeSource={RelativeSource self}}"
                                Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <!--  获得焦点 → 水印隐藏  -->
                            <!--<Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Hidden" />
                            </Trigger>-->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="PassWordTextBox"
            TargetType="PasswordBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <!--  底部横线  -->
                            <Border x:Name="Line"
                                Margin="0,28,0,0"
                                BorderThickness="0,0,0,1"
                                BorderBrush="#CCCCCC" />

                            <!--  输入区域  -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                Margin="0,0,0,5" />

                            <!--  水印文字：未输入 & 未聚焦 时显示  -->
                            <TextBlock x:Name="Watermark"
                                Text="请输入密码"
                                Margin="5,0,0,5"
                                VerticalAlignment="Center"
                                Foreground="#999999"
                                Visibility="Collapsed"
                                FontSize="14"
                                IsHitTestVisible="False" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!--  鼠标悬浮 → 底部横线高亮  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="BorderBrush" Value="#0078D7" />
                            </Trigger>

                            <DataTrigger
                                Binding="{Binding Path=Password}"
                                Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <!--  获得焦点 → 水印隐藏  -->
                            <!--<Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Hidden" />
                            </Trigger>-->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <converts:FalseToCollapsedConverter x:Key="FalseToCollapsedConverter" />

    </UserControl.Resources>


    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0"
                Source="/ParkingLot.Resources;component/Images/backImg.png"
                Stretch="Fill" />
            <StackPanel Grid.Column="1"
                Margin="0">
                <TextBlock
                    Text="用户名"
                    Margin="10,90,0,0"
                    FontSize="20"
                    Foreground="#1249bf"
                    FontWeight="Bold" />
                <TextBox x:Name="txtUserName"
                    Text="{Binding Username}"
                    FontSize="20"
                    Style="{StaticResource UserNameTextBox}" />
                <TextBlock
                    Text="密码"
                    Margin="10,40,0,0"
                    FontSize="20"
                    Foreground="#1249bf"
                    FontWeight="Bold" />
                <PasswordBox x:Name="txtPassword"
                    dpproperty:PasswordBoxHelper.PasswordEx="{Binding Password, Mode=TwoWay}"
                    Style="{StaticResource PassWordTextBox}" />

                <DockPanel Margin="10,10,10,0">
                    <CheckBox
                        Content="记住密码"
                        IsChecked="{Binding RememberPassword}"
                        VerticalAlignment="Center"
                        Foreground="#666666"
                        FontSize="13" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="#5199ec"
                        Cursor="Hand"
                        TextDecorations="Underline">
                        <TextBlock.InputBindings>
                            <MouseBinding
                                Command="{Binding ForgotPasswordCommand}"
                                MouseAction="LeftClick" />
                        </TextBlock.InputBindings>
                        忘记密码
                    </TextBlock>
                </DockPanel>

                <Button
                    Content="登录"
                    Command="{Binding LoginCommand}"
                    Height="40"
                    Margin="20"
                    FontSize="20"
                    Background="#5199ec" />

                <TextBlock
                    Text="{Binding ErrorMessage}"
                    Margin="10,10,0,0"
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Foreground="Red" />
            </StackPanel>
            <Grid.Effect>
                <BlurEffect Radius="{Binding BackEffect}" />
            </Grid.Effect>
        </Grid>


        <hc:LoadingCircle
            Grid.ColumnSpan="2"
            IsRunning="True"
            DotBorderBrush="Red"
            DotCount="5"
            Visibility="{Binding IsShow, Converter={StaticResource FalseToCollapsedConverter}}" />
    </Grid>


</UserControl>
