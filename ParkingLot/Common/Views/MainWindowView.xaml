<Window
    x:Class="ParkingLot.Main.Common.Views.MainWindowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ParkingLot"
    xmlns:prism="http://prismlibrary.com/"
    Title="智慧停车场"
    Width="1200"
    Height="750"
    prism:ViewModelLocator.AutoWireViewModel="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0"
            Background="AliceBlue">
            <StackPanel
                Height="40"
                HorizontalAlignment="Center"
                DockPanel.Dock="Top"
                Orientation="Horizontal">
                <Image
                    Width="20"
                    Height="20"
                    Source="/ParkingLot.Resources;component/Images/logo.png" />
                <TextBlock
                    Text="这是一个标题"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center" />
            </StackPanel>
            <TreeView
                ItemsSource="{Binding MenuNodes}"
                Background="Transparent">
                <!--  定义每个树节点怎么显示  -->
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding MenuHeader}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DockPanel>
    </Grid>
</Window>
