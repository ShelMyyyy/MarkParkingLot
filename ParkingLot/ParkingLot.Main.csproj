<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Core\Font\iconfont.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="Prism.DryIoc" Version="9.0.537" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.16">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.16" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Core\Interface\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ParkingLot.Core\ParkingLot.Core.csproj" />
    <ProjectReference Include="..\ParkingLot.ORM\ParkingLot.ORM.csproj" />
    <ProjectReference Include="..\ParkingLot.Resources\ParkingLot.Resources.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Core\Font\iconfont.ttf" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
